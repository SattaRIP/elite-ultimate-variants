<options>
  <!-- ======================================== -->
  <!-- MAIN CATEGORY - Core Toggles            -->
  <!-- ======================================== -->

  <option ID="Option_EliteVariants_DifficultyPreset"
          DisplayText="Difficulty Preset"
          Category="Mods: Elite Variants"
          Type="Combo"
          Values="Easy|Easy (25%),Normal|Normal (50%),Hard|Hard (75%),Brutal|Brutal (87.5%),Nightmare|Nightmare (100%),Custom|Custom"
          Default="Normal">
    <helptext>Difficulty preset. Use 'elitepreset' wish command to apply. Custom = manually configure in Custom category.</helptext>
  </option>

  <option ID="Option_EliteVariants_EnableEliteSpawning"
          DisplayText="Enable Elite Spawning"
          Category="Mods: Elite Variants"
          Type="Checkbox"
          Default="Yes">
    <helptext>Master switch for elite variant spawning.</helptext>
  </option>

  <option ID="Option_EliteVariants_EnableUltimateSpawning"
          DisplayText="Enable Ultimate Spawning"
          Category="Mods: Elite Variants"
          Type="Checkbox"
          Default="Yes">
