<?xml version="1.0" encoding="utf-8" ?>
<objects>

  <!-- Base Elite Variant Spawner (invisible trigger object) -->
  <object Name="BaseEliteVariantSpawn" Inherits="Object">
    <part Name="Render" DisplayName="elite variant spawn point" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteVariantSpawner" />
    <tag Name="BaseObject" Value="*noinherit" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <!-- Elite Variant Spawner (Tier 8) - Random tier based on zone -->
  <object Name="EliteVariantSpawn" Inherits="BaseEliteVariantSpawn">
    <tag Name="Tier" Value="8" />
  </object>

  <!-- Ultimate Variant Spawner (Tier 8) - Always ultimate tier -->
  <object Name="UltimateVariantSpawn" Inherits="BaseEliteVariantSpawn">
    <part Name="EliteVariantSpawner" ForceUltimate="true" />
    <tag Name="Tier" Value="8" />
  </object>

  <!-- Settings Wish Commands -->
  <object Name="EliteVariantsSettings" Inherits="Object">
    <part Name="Render" DisplayName="Show Elite Variants Settings" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteVariantsShowSettings" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="EliteVariantsPower1.5" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteVariantsPower15" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="EliteVariantsPower2.0" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteVariantsPower20" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="EliteVariantsLevel+10" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteVariantsLevel10" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="EliteVariantsUltimate100" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteVariantsUltimate100" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="EliteVariantsReset" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteVariantsReset" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <!-- Elite Spawn Controller - Persistent singleton for natural spawning -->
  <object Name="EliteSpawnController" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteSpawnController" />
    <tag Name="ExcludeFromDynamicEncounters" />
    <tag Name="NoSparkingDeath" />
    <intproperty Name="Indestructible" Value="1" />
  </object>

  <!-- Direct Spawn Commands (bypasses XML ForceUltimate parsing issues) -->
  <object Name="spawnelite" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="SpawnEliteCommand" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="spawnultimate" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="SpawnUltimateCommand" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <!-- Natural Spawning Wish Commands -->
  <object Name="elitespawn:status" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteSpawnStatusCommand" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="elitespawn:toggle" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteSpawnToggleCommand" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="elitespawn:reset" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteSpawnResetCommand" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <!-- Direct tier-forced spawn commands -->
  <object Name="spawnelite" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="SpawnEliteCommand" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <object Name="spawnultimate" Inherits="Object">
    <part Name="Render" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="SpawnUltimateCommand" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <!-- ===== ELITE ARMY SPAWNERS ===== -->

  <!-- Base Elite Army Spawner -->
  <object Name="BaseEliteArmySpawn" Inherits="Object">
    <part Name="Render" DisplayName="elite army spawn point" Visible="false" />
    <part Name="Physics" IsReal="false" Solid="false" />
    <part Name="EliteArmySpawner" />
    <tag Name="BaseObject" Value="*noinherit" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <!-- Small Squad (2-3 elites) -->
  <object Name="EliteArmySpawn_Small" Inherits="BaseEliteArmySpawn">
    <part Name="EliteArmySpawner" ArmyTypeString="SmallSquad" MinPlayerLevel="15" MinZoneTier="5" />
    <tag Name="Tier" Value="5" />
  </object>

  <!-- Elite Patrol (4-5 elites) -->
  <object Name="EliteArmySpawn_Medium" Inherits="BaseEliteArmySpawn">
    <part Name="EliteArmySpawner" ArmyTypeString="ElitePatrol" MinPlayerLevel="20" MinZoneTier="6" />
    <tag Name="Tier" Value="6" />
  </object>

  <!-- Elite Warband (1 ultimate + 4-5 goons) -->
  <object Name="EliteArmySpawn_Large" Inherits="BaseEliteArmySpawn">
    <part Name="EliteArmySpawner" ArmyTypeString="EliteWarband" MinPlayerLevel="25" MinZoneTier="7" />
    <tag Name="Tier" Value="7" />
  </object>

  <!-- Ultimate Host (2 ultimates + 6-8 goons) -->
  <object Name="EliteArmySpawn_Epic" Inherits="BaseEliteArmySpawn">
    <part Name="EliteArmySpawner" ArmyTypeString="UltimateHost" MinPlayerLevel="30" MinZoneTier="8" />
    <tag Name="Tier" Value="8" />
  </object>

  <!-- Titan Pair (2-3 ultimates, no goons) -->
  <object Name="EliteArmySpawn_Titans" Inherits="BaseEliteArmySpawn">
    <part Name="EliteArmySpawner" ArmyTypeString="TitanPair" MinPlayerLevel="35" MinZoneTier="8" />
    <tag Name="Tier" Value="8" />
  </object>

  <!-- ===== ELITE ARMY WISH COMMANDS ===== -->

