<?xml version="1.0" encoding="utf-8" ?>
<options>
  <!-- ===== DIFFICULTY PRESET ===== -->
  <option ID="Option_EliteVariants_DifficultyPreset"
          DisplayText="Difficulty Preset"
          Category="Mods: Elite Variants"
          Type="Combo"
          Values="Custom|Custom (Manual),Normal|Normal (Balanced),Hard|Hard (Challenging),Brutal|Brutal (Very Hard),Nightmare|Nightmare (Maximum)"
          Default="Normal">
    <helptext>Quick difficulty presets. Select 'Custom' to manually configure all settings below.</helptext>
  </option>

  <!-- ===== CORE SETTINGS (Always visible) ===== -->
  <option ID="Option_EliteVariants_EnableEliteSpawning"
          DisplayText="Enable Elite Spawning"
          Category="Mods: Elite Variants"
          Type="Checkbox"
          Default="Yes">
    <helptext>Master switch for natural elite variant spawning.</helptext>
  </option>

  <option ID="Option_EliteVariants_EnableUltimateSpawning"
          DisplayText="Enable Ultimate Spawning"
          Category="Mods: Elite Variants"
          Type="Checkbox"
          Default="Yes">
    <helptext>Master switch for natural ultimate variant spawning.</helptext>
  </option>

  <option ID="Option_EliteVariants_EnableArmySpawning"
          DisplayText="Enable Army Spawning"
          Category="Mods: Elite Variants"
          Type="Checkbox"
          Default="Yes">
    <helptext>Enable elite army encounters (groups of elites/ultimates spawning together).</helptext>
  </option>

  <option ID="Option_EliteVariants_EnableDebugMode"
          DisplayText="Enable Debug Mode"
          Category="Mods: Elite Variants"
          Type="Checkbox"
          Default="No">
    <helptext>Enable verbose spawn notifications and testing features.</helptext>
  </option>

  <!-- ===== CUSTOM SETTINGS (Only visible when preset is Custom) ===== -->

  <!-- Elite Power/HP -->
  <option ID="Option_EliteVariants_ElitePowerMultiplier"
          DisplayText="[Elite] Power Multiplier"
          Category="Mods: Elite Variants"
          Requires="Option_EliteVariants_DifficultyPreset==Custom"
          Type="Slider"
          Min="10"
          Max="30"
          Increment="5"
          Default="10">
    <helptext>Stat/AV/DV scaling for elite variants. 10 = 1.0x, 30 = 3.0x</helptext>
  </option>

  <option ID="Option_EliteVariants_EliteHPMultiplier"
          DisplayText="[Elite] HP Multiplier"
          Category="Mods: Elite Variants"
          Requires="Option_EliteVariants_DifficultyPreset==Custom"
          Type="Slider"
          Min="10"
          Max="50"
          Increment="5"
          Default="15">
    <helptext>HP multiplier for elite variants. 10 = 1.0x, 50 = 5.0x</helptext>
  </option>

  <option ID="Option_EliteVariants_EliteEnhancementMultiplier"
          DisplayText="[Elite] Enhancement Multiplier"
          Category="Mods: Elite Variants"
          Requires="Option_EliteVariants_DifficultyPreset==Custom"
          Type="Slider"
          Min="10"
          Max="30"
          Increment="5"
          Default="10">
    <helptext>Scales mutations, cybernetics, and equipment. 10 = 1.0x, 30 = 3.0x</helptext>
  </option>

  <option ID="Option_EliteVariants_EliteLevelOffset"
          DisplayText="[Elite] Level Offset"
          Category="Mods: Elite Variants"
          Requires="Option_EliteVariants_DifficultyPreset==Custom"
          Type="Slider"
          Min="0"
          Max="30"
          Increment="5"
          Default="0">
    <helptext>Level bonus added to elite variants.</helptext>
  </option>

  <!-- Ultimate Power/HP -->
  <option ID="Option_EliteVariants_UltimatePowerMultiplier"
